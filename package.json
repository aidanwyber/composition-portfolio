{
	"name": "composer-portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#data/*": "./src/data/*.ts",
		"#locales": "./src/locales/index.ts",
		"#components/*": "./src/components/*.svelte",
		"#lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build && node scripts/postbuild.mjs && node scripts/verify-build.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"preview": "node scripts/serve.mjs",
		"prepare": "svelte-kit sync"
	},
	"dependencies": {
		"svelte": "^5.57.3"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	}
}
